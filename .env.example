# Only variable v3 needs. Copy to .env.local and fill in.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Secret-only (never commit): TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID (used by /api/notify)
# Optional: AUTH_SECRET (session signing), SERVER_URL (self-ping/base URL), PROOF_BIN (proof binary path)
