# Persistent Postgres used by Physicoin V3.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Cloaked Physicoin application origin. Server-side only.
CLOAKED_PHYSICOIN_URL=https://<scrubbed-url-domain>

# Secret-only (never commit): TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID (used by /api/notify)
# Optional: AUTH_SECRET (session signing), SERVER_URL (self-ping/base URL), PROOF_BIN (proof binary path)
